#!/bin/sh
SWAPFILE=/userdata/swapfile
SWAPSIZE_MB=256

case "$1" in
start)
    # Wait for userdata mount
    cnt=0
    while [ $cnt -lt 30 ]; do
        cnt=$((cnt + 1))
        mount | grep -qw userdata && break
        sleep .1
    done

    if [ ! -f "$SWAPFILE" ]; then
        echo "Creating ${SWAPSIZE_MB}MB swap..."
        dd if=/dev/zero of="$SWAPFILE" bs=1M count="$SWAPSIZE_MB" status=none
        chmod 600 "$SWAPFILE"
        /sbin/mkswap "$SWAPFILE" >/dev/null
    fi

    if ! grep -q "$SWAPFILE" /proc/swaps 2>/dev/null; then
        /sbin/swapon "$SWAPFILE" && echo "swapon ok"
    fi
    sysctl -w vm.swappiness=10 >/dev/null 2>&1
    ;;
stop)
    [ -f "$SWAPFILE" ] && /sbin/swapoff "$SWAPFILE" 2>/dev/null
    ;;
esac
