#!/bin/sh
# PicoKVM post-boot init — runs after userdata mount, before appinit
# Ensures sshd user, authorized_keys, and go.sh customizations persist

case "$1" in
start)
    # Wait for userdata
    cnt=0
    while [ $cnt -lt 30 ]; do
        cnt=$((cnt + 1))
        mount | grep -qw userdata && break
        sleep .1
    done

    # sshd privilege separation user
    grep -q "^sshd:" /etc/passwd || \
        echo "sshd:x:74:74:sshd:/var/empty/sshd:/sbin/nologin" >> /etc/passwd
    mkdir -p /var/empty/sshd

    # authorized_keys from userdata
    if [ -f /userdata/root/.ssh/authorized_keys ]; then
        mkdir -p /root/.ssh
        chmod 700 /root/.ssh
        cp /userdata/root/.ssh/authorized_keys /root/.ssh/authorized_keys
        chmod 600 /root/.ssh/authorized_keys
    fi

    # Persist SSH host keys across firmware upgrades
    # Save to /userdata on first boot, restore on subsequent boots
    SSH_KEYS_DIR=/userdata/picokvm/ssh_host_keys
    mkdir -p "$SSH_KEYS_DIR"
    if [ -f "$SSH_KEYS_DIR/ssh_host_rsa_key" ]; then
        # Restore saved host keys
        cp "$SSH_KEYS_DIR"/ssh_host_*_key* /etc/ssh/ 2>/dev/null
        chmod 600 /etc/ssh/ssh_host_*_key
        chmod 644 /etc/ssh/ssh_host_*_key.pub
    else
        # First boot — generate keys then save them
        ssh-keygen -A 2>/dev/null
        cp /etc/ssh/ssh_host_*_key* "$SSH_KEYS_DIR/" 2>/dev/null
    fi

    # Persist Tailscale state across firmware upgrades
    # Symlink /var/lib/tailscale to /userdata so auth survives rootfs writes
    TS_DATA=/userdata/picokvm/tailscale
    mkdir -p "$TS_DATA"
    if [ -d /var/lib/tailscale ] && [ ! -L /var/lib/tailscale ]; then
        # First boot after upgrade — migrate existing state if any
        cp -a /var/lib/tailscale/* "$TS_DATA/" 2>/dev/null
        rm -rf /var/lib/tailscale
    fi
    [ ! -e /var/lib/tailscale ] && ln -sf "$TS_DATA" /var/lib/tailscale

    # Run go.sh if it exists (Entware, locale, swap, shell config)
    if [ -x /userdata/go.sh ]; then
        /userdata/go.sh > /tmp/go.sh.log 2>&1
    fi
    ;;
stop)
    ;;
esac
