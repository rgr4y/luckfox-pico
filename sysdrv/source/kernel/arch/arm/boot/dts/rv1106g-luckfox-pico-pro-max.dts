/**********NPU**********/
//&npu {
//	assigned-clock-rates = <700000000>;
//};

/**********FLASH**********/
&sfc {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********SDMMC**********/
&sdmmc {
	max-freqency = <50000000>;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;

	//sdio
	cap-sdio-irq;
	non-removable;
	no-1-8-v;
	supports-sdio;

	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	status = "okay";
};

/* ESP-Hosted WiFi moved from SDIO to SPI (easier hand-soldering, ~16 Mbps is
 * plenty for this host). See the &spi0 node below and docs/esp-hosted-spi-plan.md. */

/**********WATCHDOG**********/
/* dw-wdt (snps,dw-wdt @ff5a0000): on expiry the CRU issues a global soft reset
 * (== the RESET button). Fed at boot by /sbin/watchdog (busybox). Disabled in
 * the stock DT; enable so a hung kernel/userspace self-resets. */
&wdt {
	status = "okay";
};

/**********ETH**********/
&gmac {
	status = "okay";
};

/**********USB**********/
&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,dis-u2-susphy;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	status = "okay";
	/* HOST by default: brings up the dwc3 xhci so USB peripherals (e.g. the
	 * rtl8821cu/88x2bu WiFi dongle) enumerate. This disables the gadget path
	 * (no usb0 RNDIS). For the gadget build see the peripheral DTS variant
	 * (rv1106g-luckfox-pico-pro-max-peripheral.dts). NOTE: role is NOT
	 * runtime-switchable under a single-role dr_mode — dwc3 only provisions the
	 * one stack at probe, so the PHY otg_mode / dwc3 debugfs `mode` levers are
	 * no-ops. Switching host<->gadget = reflash the other DTS variant. */
	dr_mode = "host";
};

/**********SPI (ESP-Hosted-NG WiFi co-processor) — see docs/esp-hosted-spi-plan.md**********/
/* spi0 = bus 0 (alias in rv1106.dtsi). The esp32_spi module registers an
 * "esp_spi" device on bus0/CS0 (SPI MODE 2) at modprobe — no DT child needed,
 * it's added programmatically via spi_new_device(). HANDSHAKE/DATA_READY are
 * GPIO #defines in host/spi/esp_spi.h (56/57 = GPIO1_D0/D1).
 * m0 mux: CLK=GPIO1_C1(pin14) MOSI=GPIO1_C2(pin15) MISO=GPIO1_C3(pin16)
 *         CS0=GPIO1_C0(pin12).  HS=pin19(gpio56)  DR=pin20(gpio57).
 * No ESP soldered? Leave the module out of insmod (it isn't auto-loaded) — an
 * enabled-but-idle SPI master costs nothing at boot. */
&spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi0m0_pins &spi0m0_cs0>;
};

/**********I2C**********/
/* I2C3_M1 */
&i2c3 {
	status = "disabled";
	clock-frequency = <100000>;
};

/* I2C1_M1 */
&i2c1 {
	status = "disabled";
	clock-frequency = <100000>;
};


/**********UART**********/
/* UART3_M1 */
&uart3 {
	status = "disabled";
};

/* UART4_M1 */
&uart4 {
	status = "disabled";
};

/**********RTC**********/
&rtc {
	status = "okay";
};
