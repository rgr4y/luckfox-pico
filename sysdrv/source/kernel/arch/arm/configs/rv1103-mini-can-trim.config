# Luckfox Pico Mini CAN edge node: strip unused vision-SoC subsystems (GPU/display,
# camera/media, audio) to shrink the kernel image / free RAM on the 64MB RV1103.
# Storage(mmc), SPI(can), USB(wifi), IIO/saradc, watchdog, gpio, i2c untouched.
# CONFIG_DRM is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SND is not set
# regdb: built-in sforshee cert can't verify wireless-regdb-2025's sig, so require-signed
# rejects the db and pins world regdomain. The symbol's prompt is gated behind
# CERTIFICATION_ONUS, so enable that to expose it, then disable the requirement.
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
