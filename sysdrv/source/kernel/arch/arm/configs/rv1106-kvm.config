# PicoKVM kernel config fragment
# HDMI-to-CSI bridge (Toshiba TC358743)
CONFIG_VIDEO_TC358743=m
CONFIG_VIDEO_TC35874X=m

# RTL8821CU USB Bluetooth (combo dongle, BT side). Built as modules and
# loaded at boot by overlay S30rtldrv. WiFi side is the out-of-tree
# rtl8821cu driver (see RK_ENABLE_WIFI_CHIP=RTL8821CU in the board config).
CONFIG_RFKILL=m
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_RTL=m
# Crypto used by the BT SMP/LE pairing path
CONFIG_CRYPTO_ECDH=m
CONFIG_CRYPTO_ECB=m
CONFIG_CRYPTO_CMAC=m
CONFIG_CRYPTO_AES=m
